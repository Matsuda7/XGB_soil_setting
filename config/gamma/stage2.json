{
  "input": "gamma_test/routed_models/augmented.csv",
  "stage1_settings": "gamma_test/routed_models/settings.json",
  "output": "gamma_test/stage2_baseline_borehole",
  "numeric_features": [
    "x",
    "y",
    "elevation"
  ],
  "categorical_features": [],
  "primary_validation": "borehole",
  "validation_modes": [
    "borehole"
  ],
  "split_seeds": [
    42,
    43,
    44,
    45,
    46
  ],
  "test_size": 0.2,
  "validation_size": 0.2,
  "stage1_inner_validation_size": 0.2,
  "sample_weight": 1.0,
  "xgb_parameters": {
