    "max_depth": 7,
    "min_child_weight": 3,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_alpha": 0.05,
    "reg_lambda": 1.0,
    "random_state": 42,
    "n_jobs": 4,
    "tree_method": "hist",
    "eval_metric": "rmse",
    "early_stopping_rounds": 75
  }
