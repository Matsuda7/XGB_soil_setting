    "S1": {
      "numeric": [
        "x",
        "y",
        "elevation",
        "representative_total_sand",
        "representative_silt",
        "representative_clay"
      ],
      "categorical": []
    },
    "S2": {
      "numeric": [
        "x",
        "y",
        "elevation"
      ],
      "categorical": [
        "geology"
      ]
    },
    "S3": {
      "numeric": [
        "x",
        "y",
        "elevation",
        "representative_total_sand",
        "representative_silt",
        "representative_clay"
      ],
      "categorical": [
        "geology"
      ]
    }
  },
  "xgb_parameters": {
